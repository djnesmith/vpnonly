#!/bin/bash
# vpnonly — put the apps you pick on NordVPN, leave everything else alone.
#
#   vpnonly [pick]     tick running apps to put on the VPN, untick to take off
#   vpnonly rm APP…    take apps off the VPN (quit, reopen normally)
#   vpnonly ls         tunnel state, server, exit IP, apps on the VPN
#   vpnonly down       take the tunnel down
#   vpnonly all        hand the whole Mac back to the NordVPN app
#
# Everything underneath is up.sh, run.sh and down.sh; this is the front end.
set -uo pipefail

# Resolve through symlinks so this works when linked onto PATH, where $0
# points at the link rather than the repo.
SELF="$0"
while [ -L "$SELF" ]; do
    LINK=$(readlink "$SELF")
    case "$LINK" in
        /*) SELF="$LINK" ;;
        *)  SELF="$(dirname "$SELF")/$LINK" ;;
    esac
done
DIR="$(cd "$(dirname "$SELF")" && pwd)"
SELF="$DIR/$(basename "$SELF")"
case "${1:-}" in -h|--help|help)
    sed -n '2,10p' "$SELF" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
# sudo resets PATH, so re-exec by absolute path.
[ "$(id -u)" = 0 ] || exec sudo -- "$SELF" "$@"
RUSER="${SUDO_USER:?run from your normal account, not as root}"
RUID=$(id -u "$RUSER")
RHOME=$(dscl . -read "/Users/$RUSER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
CONF="${RHOME:-$HOME}/.config/vpnonly"
ANCHOR="com.apple/vpnonly-cli"
NORD_APP="NordVPN"

# --- state -------------------------------------------------------------------

tunnel_if() { cat "$CONF/tunnel-if" 2>/dev/null || true; }

tunnel_up() {
    local i; i=$(tunnel_if)
    [ -n "$i" ] && ifconfig "$i" >/dev/null 2>&1
}

vpn_gid() { dscl . -read /Groups/vpnonly PrimaryGroupID 2>/dev/null | awk '{print $2}'; }

# Bundle path of every process path on stdin that is an app's own executable
# (Foo.app/Contents/MacOS/...), outermost bundle only, so a helper nested
# inside Frameworks counts as its app.
bundles() {
    awk '{
        i = index($0, ".app/"); if (!i) next
        if (substr($0, i + 4, 15) == "/Contents/MacOS") print substr($0, 1, i + 3)
    }' | sort -u
}

# Apps with at least one process carrying the group.
routed_apps() {
    local g; g=$(vpn_gid); [ -n "$g" ] || return 0
    ps -axo rgid=,comm= 2>/dev/null |
        awk -v g="$g" '$1 == g { sub(/^[ \t]*[0-9]+[ \t]+/, ""); print }' | bundles
}

# The terminal this runs in. Quitting it would kill vpnonly mid-change.
own_terminal() {
    local pid=$$ comm
    while [ "${pid:-0}" -gt 1 ]; do
        comm=$(ps -p "$pid" -o comm= 2>/dev/null) || break
        case "$comm" in *.app/Contents/MacOS/*) printf '%s\n' "$comm" | bundles; return ;; esac
        pid=$(ps -p "$pid" -o ppid= 2>/dev/null | tr -d ' ')
    done
}

cannot_route() {
    case "$(basename "$1")" in
        # WebKit makes its connections from system processes outside the group.
        Safari.app|"Safari Technology Preview.app") return 0 ;;
        # Docker carries the vpn-inc proxy containers, which must keep the
        # normal route. The NordVPN app is the other tunnel, not a passenger.
        Docker.app|"$NORD_APP.app") return 0 ;;
    esac
    [ "$1" = "$TERMINAL_APP" ]
}

# The user's running apps from /Applications or ~/Applications.
running_apps() {
    ps -axo uid=,comm= 2>/dev/null |
        awk -v u="$RUID" -v h="$RHOME" '$1 == u {
            sub(/^[ \t]*[0-9]+[ \t]+/, "")
            if (index($0, "/Applications/") == 1 || index($0, h "/Applications/") == 1) print
        }' | bundles
}

pids_of() {
    ps -axo pid=,comm= 2>/dev/null |
        awk -v a="$1/Contents/MacOS/" '{ p = $1; sub(/^[ \t]*[0-9]+[ \t]+/, "") } index($0, a) == 1 { print p }'
}

app_name() { basename "$1" .app; }

in_list() {
    local x="$1"; shift
    local y
    for y in "$@"; do [ "$x" = "$y" ] && return 0; done
    return 1
}

# True only when the block rule is in the kernel and PF is enforcing it.
kill_switch_loaded() {
    local g; g=$(vpn_gid); [ -n "$g" ] || return 1
    pfctl -s info 2>/dev/null | grep -q '^Status: Enabled' || return 1
    pfctl -a "$ANCHOR" -s rules 2>/dev/null |
        grep -q "^block return out quick on ! lo0 all group = $g\$"
}

group_busy() {
    local g; g=$(vpn_gid); [ -n "$g" ] || return 1
    ps -axo rgid= 2>/dev/null | awk -v g="$g" '$1 == g { f = 1; exit } END { exit !f }'
}

# down.sh keeps the kill switch while a routed app is open. Once the last one
# is gone and the tunnel is down, finish that teardown.
settle() {
    tunnel_up && return 0
    [ -s "$CONF/pf-token" ] || return 0
    group_busy && return 0
    "$DIR/down.sh" >/dev/null 2>&1 || true
}

nord_running() { pgrep -x "$NORD_APP" >/dev/null 2>&1; }

# Another VPN is connected when internet traffic leaves through a utun that
# isn't ours. A public address, not "default": VPNs often install 0/1 +
# 128/1, which beat the default route without replacing it. Not tied to the
# NordVPN process: its tunnel lives in a system extension that can outlast it.
other_vpn_connected() {
    local i; i=$(route -n get 1.1.1.1 2>/dev/null | awk '/interface:/{print $2; exit}')
    case "$i" in utun*) [ "$i" != "$(tunnel_if)" ] ;; *) return 1 ;; esac
}

# --- actions -----------------------------------------------------------------

# Quit an app and wait until every process of it is gone. The name is passed
# as an argument, never pasted into the script: this runs as root.
quit_app() {
    local app="$1" _
    [ -n "$(pids_of "$app")" ] || return 0
    osascript -e 'on run argv' -e 'quit app (item 1 of argv)' -e 'end run' \
        "$(app_name "$app")" >/dev/null 2>&1 || true
    for _ in $(seq 1 60); do
        [ -z "$(pids_of "$app")" ] && return 0
        sleep 0.25
    done
    echo "  ✗ $(app_name "$app") did not quit (unsaved work?). Quit it yourself and try again."
    return 1
}

ensure_tunnel() {
    tunnel_up && return 0
    echo "Bringing the NordVPN tunnel up…"
    "$DIR/up.sh" || { echo "  ✗ tunnel did not come up; nothing was moved."; return 1; }
    echo
}

turn_on() {
    local app="$1"
    quit_app "$app" || return 1
    "$DIR/run.sh" "$app"
}

turn_off() {
    local app="$1" name; name=$(app_name "$app")
    quit_app "$app" || return 1
    if sudo -u "$RUSER" open -a "$app" 2>/dev/null; then
        echo "  ✓ $name reopened on your normal connection."
    else
        echo "  $name is closed. Open it when you want it back."
    fi
}

# The NordVPN app and this tunnel can't both be up: ours would ride inside
# its tunnel and break on MTU, and its tunnel is what breaks the vpn-inc
# containers. So it has to go. Offer to quit it rather than refuse outright.
ensure_nord_quit() {
    nord_running || return 0
    if other_vpn_connected; then
        echo "The NordVPN app is connected and carrying your whole Mac."
    else
        echo "The NordVPN app is open (not connected)."
    fi
    printf 'vpnonly replaces it for the apps you pick. Quit the NordVPN app now? [Y/n] '
    local reply _; read -r reply </dev/tty
    case "$reply" in
        n|N|no|NO)
            other_vpn_connected && { echo "Disconnect NordVPN first, then run vpnonly again."; return 1; }
            return 0 ;;
    esac
    osascript -e 'on run argv' -e 'quit app (item 1 of argv)' -e 'end run' "$NORD_APP" >/dev/null 2>&1 || true
    for _ in $(seq 1 40); do
        nord_running || break
        sleep 0.25
    done
    # Its extension can take a moment to drop the tunnel after the app quits.
    for _ in $(seq 1 20); do
        other_vpn_connected || break
        sleep 0.25
    done
    if other_vpn_connected; then
        echo "NordVPN is still connected. Disconnect it in the app, quit it, then run vpnonly again."
        return 1
    fi
    echo "  ✓ NordVPN app closed."
    echo
}

# --- picker ------------------------------------------------------------------

# Checkbox list over ITEMS; CHECKED holds 0/1 per item. Space toggles, Enter
# applies, q cancels. No fzf: it cannot preselect rows, and the routed apps
# have to start ticked. Returns 1 on cancel.
picker() {
    local sel=0 top=0 rows view i mark name key rest
    restore() { printf '\e[?25h\e[?1049l'; }
    trap 'restore; exit 130' INT
    printf '\e[?1049h\e[?25l'
    while :; do
        rows=$(tput lines 2>/dev/null || echo 24)
        view=$((rows - 9)); [ "$view" -lt 3 ] && view=3
        [ "${#ITEMS[@]}" -lt "$view" ] && view=${#ITEMS[@]}
        [ "$sel" -lt "$top" ] && top=$sel
        [ "$sel" -ge $((top + view)) ] && top=$((sel - view + 1))
        printf '\e[H\e[J'
        printf '  \e[1mWhich running apps go through NordVPN?\e[0m\n'
        if tunnel_up; then
            printf '  \e[2mtunnel up on %s · %s\e[0m\n\n' "$(tunnel_if)" "$(cat "$CONF/tunnel-server" 2>/dev/null || echo '?')"
        else
            printf '  \e[2mtunnel down · it comes up when you apply\e[0m\n\n'
        fi
        i=$top
        while [ "$i" -lt $((top + view)) ] && [ "$i" -lt "${#ITEMS[@]}" ]; do
            name=$(app_name "${ITEMS[$i]}")
            if [ "${CHECKED[$i]}" = 1 ]; then mark=$'\e[32m[x]\e[0m'; else mark='[ ]'; fi
            if [ "$i" -eq "$sel" ]; then
                printf '\e[36m▶\e[0m %s \e[1m%s\e[0m\n' "$mark" "$name"
            else
                printf '  %s %s\n' "$mark" "$name"
            fi
            i=$((i + 1))
        done
        printf '\n  \e[2mmacOS fixes an app'"'"'s network at launch, so every app you change\n'
        printf '  is quit and reopened. Save your work first.\e[0m\n'
        printf '\n  \e[2m↑↓ move · space tick · enter apply · q cancel\e[0m'

        IFS= read -rsn1 key </dev/tty || { restore; return 1; }
        case "$key" in
            $'\e')
                # bash 3.2 rejects a fractional -t; an arrow sends all three
                # bytes at once, so the blocking read is safe.
                IFS= read -rsn2 rest </dev/tty || rest=""
                case "$rest" in
                    '[A') [ "$sel" -gt 0 ] && sel=$((sel - 1)) ;;
                    '[B') [ "$sel" -lt $((${#ITEMS[@]} - 1)) ] && sel=$((sel + 1)) ;;
                esac ;;
            k) [ "$sel" -gt 0 ] && sel=$((sel - 1)) ;;
            j) [ "$sel" -lt $((${#ITEMS[@]} - 1)) ] && sel=$((sel + 1)) ;;
            " ") if [ "${CHECKED[$sel]}" = 1 ]; then CHECKED[$sel]=0; else CHECKED[$sel]=1; fi ;;
            q|Q) restore; trap - INT; return 1 ;;
            "") restore; trap - INT; return 0 ;;
        esac
    done
}

# --- commands ----------------------------------------------------------------

cmd_pick() {
    [ -t 0 ] && [ -t 1 ] || { echo "vpnonly pick needs a terminal"; return 1; }
    ensure_nord_quit || return 1

    local app i
    ROUTED=(); ITEMS=(); CHECKED=()
    IFS=$'\n' read -r -d '' -a ROUTED < <(routed_apps && printf '\0') || true
    while IFS= read -r app; do
        [ -n "$app" ] || continue
        cannot_route "$app" && ! in_list "$app" ${ROUTED[@]+"${ROUTED[@]}"} && continue
        ITEMS+=("$app")
        if in_list "$app" ${ROUTED[@]+"${ROUTED[@]}"}; then CHECKED+=(1); else CHECKED+=(0); fi
    done < <({ running_apps; routed_apps; } | sort -u |
             awk -F/ '{ print $NF "\t" $0 }' | sort -f | cut -f2-)
    [ "${#ITEMS[@]}" -gt 0 ] || { echo "no running apps found in /Applications"; return 1; }

    picker || { echo "nothing changed"; return 0; }

    local on=() off=()
    for i in "${!ITEMS[@]}"; do
        app="${ITEMS[$i]}"
        if [ "${CHECKED[$i]}" = 1 ]; then
            in_list "$app" ${ROUTED[@]+"${ROUTED[@]}"} || on+=("$app")
        else
            in_list "$app" ${ROUTED[@]+"${ROUTED[@]}"} && off+=("$app")
        fi
    done
    [ "${#on[@]}" -gt 0 ] || [ "${#off[@]}" -gt 0 ] || { echo "nothing changed"; return 0; }

    local rc=0
    for app in ${off[@]+"${off[@]}"}; do turn_off "$app" || rc=1; done
    if [ "${#on[@]}" -gt 0 ]; then
        ensure_tunnel || return 1
        for app in "${on[@]}"; do turn_on "$app" || rc=1; done
    fi
    echo
    cmd_ls
    return $rc
}

# Match an argument to a routed app: a full bundle path, or a name.
resolve_routed() {
    local want="$1" app
    [ -d "$want" ] && { printf '%s\n' "${want%/}"; return; }
    for app in ${ROUTED[@]+"${ROUTED[@]}"}; do
        [ "$(app_name "$app" | tr '[:upper:]' '[:lower:]')" = "$(printf '%s' "$want" | tr '[:upper:]' '[:lower:]')" ] &&
            { printf '%s\n' "$app"; return; }
    done
}

cmd_rm() {
    ROUTED=()
    IFS=$'\n' read -r -d '' -a ROUTED < <(routed_apps && printf '\0') || true
    if [ "$#" -eq 0 ]; then
        echo "usage: vpnonly rm APP…   (or untick it in: vpnonly pick)"
        [ "${#ROUTED[@]}" -gt 0 ] && { echo "on the VPN now:"; for a in "${ROUTED[@]}"; do echo "  $(app_name "$a")"; done; }
        return 1
    fi
    local rc=0 want app
    for want in "$@"; do
        app=$(resolve_routed "$want")
        if [ -z "$app" ] || ! in_list "$app" ${ROUTED[@]+"${ROUTED[@]}"}; then
            echo "  $want is not on the VPN."; rc=1; continue
        fi
        turn_off "$app" || rc=1
    done
    settle
    return $rc
}

cmd_ls() {
    local app ip
    ROUTED=()
    IFS=$'\n' read -r -d '' -a ROUTED < <(routed_apps && printf '\0') || true
    settle
    if tunnel_up; then
        ip=$("$DIR/vpnrun" "$RUSER" /usr/bin/curl -q -s --max-time 8 https://api.ipify.org 2>/dev/null)
        echo "tunnel:   up on $(tunnel_if)"
        echo "server:   $(cat "$CONF/tunnel-server" 2>/dev/null || echo '?')"
        echo "exit IP:  ${ip:-(no answer — tunnel up but not passing traffic)}"
    elif [ "${#ROUTED[@]}" -gt 0 ] && kill_switch_loaded; then
        echo "tunnel:   down — kill switch holding the apps below offline"
    elif [ "${#ROUTED[@]}" -gt 0 ]; then
        echo "tunnel:   down — apps below carry the group but NO rule is loaded; run: vpnonly down"
    else
        echo "tunnel:   down"
    fi
    echo "your IP:  $(curl -q -s --max-time 6 https://api.ipify.org 2>/dev/null || echo '?')"
    nord_running && echo "NordVPN:  app is open"
    other_vpn_connected && echo "warning:  another VPN (NordVPN app?) is carrying the whole Mac"
    if [ "${#ROUTED[@]}" -gt 0 ]; then
        echo "on the VPN:"
        for app in "${ROUTED[@]}"; do echo "  $(app_name "$app")"; done
    else
        echo "on the VPN: nothing"
    fi
}

cmd_down() {
    "$DIR/down.sh"
}

# Everything through the NordVPN app. Routed apps are reopened normally
# first, or the kill switch would hold them offline once our tunnel is gone.
cmd_all() {
    local app rc=0
    ROUTED=()
    IFS=$'\n' read -r -d '' -a ROUTED < <(routed_apps && printf '\0') || true
    for app in ${ROUTED[@]+"${ROUTED[@]}"}; do turn_off "$app" || rc=1; done
    if [ "$rc" -ne 0 ]; then
        echo "Some apps are still on the VPN; leaving the tunnel up. Quit them and run vpnonly all again."
        return 1
    fi
    "$DIR/down.sh" >/dev/null 2>&1
    tunnel_up && { echo "the tunnel did not come down; see: vpnonly down"; return 1; }
    echo "  ✓ vpnonly tunnel and rules removed."
    sudo -u "$RUSER" open -a "$NORD_APP" 2>/dev/null ||
        { echo "could not open the $NORD_APP app"; return 1; }
    echo "  ✓ NordVPN app opened. Click Connect if it doesn't auto-connect."
    echo "  Note: while NordVPN carries the whole Mac, pg and the vpn-inc containers stop working."
    echo "  Back to per-app: vpnonly pick"
}

TERMINAL_APP=$(own_terminal)
cmd="${1:-pick}"; [ "$#" -gt 0 ] && shift
case "$cmd" in
    pick) cmd_pick ;;
    rm)   cmd_rm "$@" ;;
    ls)   cmd_ls ;;
    down) cmd_down ;;
    all)  cmd_all ;;
    *)    echo "unknown command: $cmd (try: vpnonly help)"; exit 1 ;;
esac
